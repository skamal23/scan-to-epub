{
  "name": "book-to-epub-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "bundle:reader": "node scripts/bundle-reader.cjs",
    "postinstall": "node scripts/bundle-reader.cjs"
  },
  "dependencies": {
    "@babel/runtime": "^8.1.2",
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "epubjs": "^0.3.93",
    "expo": "~58.0.25",
    "expo-camera": "~58.0.14",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-linear-gradient": "~58.0.4",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "fast-xml-parser": "^5.12.0",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.10.1",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*))"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  },
  "packageManager": "pnpm@11.7.0"
}
